<?xml version="1.0" encoding="utf-8"?>
<!--
  RiffDeck brushed-metal resting-state card look for list rows. Used as
  android:background; the original @drawable/rect_selector_strong ripple is
  kept as android:foreground on the same view (Android natively supports
  layering background + foreground drawables on one view without needing to
  nest a <ripple> inside a <layer-list>, which is a known source of masking
  bugs).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/m3_card_corner_radius" />
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#2A2E35"
        android:endColor="#1E2126" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
