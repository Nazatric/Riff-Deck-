<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark bottom-right shadow edge (offset base layer) -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#15171B"/>
        </shape>
    </item>
    <!-- Main button face -->
    <item android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#565D68"
                android:endColor="#3B4048"/>
        </shape>
    </item>
    <!-- Light top-left highlight edge -->
    <item android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#AEB6C2"/>
        </shape>
    </item>
</layer-list>
