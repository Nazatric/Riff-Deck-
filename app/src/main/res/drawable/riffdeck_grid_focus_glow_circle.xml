<?xml version="1.0" encoding="utf-8"?>
<!--
  Circular variant of riffdeck_grid_focus_glow.xml, for round artist avatar
  tiles where a square-cornered glow would clash with the circular image.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
        android:color="#66FF5A6E">

    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="#FF5A6E" />
                    <solid android:color="#33FF5A6E" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="#FFB020" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
